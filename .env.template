# Environment Variables Template
# Copy this file to .env and fill with your actual values
# IMPORTANT: .env should NOT be committed to git

# ========== GROQ LLM API ==========
# Get from: https://console.groq.com
# Free tier available, no credit card needed
GROQ_API_KEY=gsk_your_api_key_here

# ========== QDRANT VECTOR DATABASE ==========
# Option 1: Local Qdrant (Free)
# Run: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Option 2: Cloud Qdrant (Free tier available)
# Sign up: https://cloud.qdrant.io
# QDRANT_URL=https://xxxxx-xxxxx.qdrant.io
# QDRANT_API_KEY=xxxxxxxxxxxxxxxx

# ========== ADMIN CREDENTIALS ==========
# Choose your own username and secure password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# ========== FLASK SECURITY ==========
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-long-random-secret-key-here

# ========== OPTIONAL: HUGGINGFACE BACKUP ==========
# For document backup to Hugging Face Hub
HF_TOKEN=hf_your_token_here
HF_DATASET=username/dataset-name
